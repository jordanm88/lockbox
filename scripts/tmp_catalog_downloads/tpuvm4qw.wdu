                <li><a href="//get.videolan.org/vlc/3.0.23/win32/vlc-3.0.23-win32.exe">Windows</a></li><li><a href="//get.videolan.org/vlc/3.0.23/win64/vlc-3.0.23-win64.exe">Windows 64bit</a></li><li><a href="//get.videolan.org/vlc/3.0.23/winarm64/vlc-3.0.23-winarm64.exe">Windows ARM 64</a></li><li><a href="//get.videolan.org/vlc/3.0.23/macosx/vlc-3.0.23-intel64.dmg">macOS</a></li><li><a href="//get.videolan.org/vlc/3.0.23/macosx/vlc-3.0.23-arm64.dmg">macOS (Apple Silicon)</a></li><li><a href="/vlc/#download">Linux</a></li><li><a href="//play.google.com/store/apps/details?id=org.videolan.vlc">Android</a></li>                <li role="separator" class="divider"></li>
