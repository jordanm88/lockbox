{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lockbox.app/schemas/catalog.schema.json",
  "title": "Lockbox Portable App Catalog",
  "description": "Remote (or bundled-fallback) manifest of portable apps installable into USB_ROOT/Apps.",
  "type": "object",
  "required": ["schemaVersion", "apps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "apps": {
      "type": "array",
      "items": { "$ref": "#/$defs/app" }
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "required": ["id", "name", "description", "icon", "targets"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Also used as the install directory name: Apps/<id>/"
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string", "description": "A single emoji glyph." },
        "homepage": { "type": "string", "format": "uri" },
        "category": {
          "type": "string",
          "description": "Grouping shown as a filter chip in the App Store UI, e.g. 'Office', 'Development', 'Utilities'."
        },
        "targets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "windows": { "$ref": "#/$defs/target" },
            "macos": { "$ref": "#/$defs/target" },
            "linux": { "$ref": "#/$defs/target" }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["url", "archiveType", "launcher"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "archiveType": {
          "type": "string",
          "enum": ["zip", "tar.gz", "appimage", "binary", "exe", "installer"],
          "description": "zip/tar.gz are extracted into Apps/<id>/; appimage/binary/exe are saved as single files; installer runs a silent Windows setup into Apps/<id>/."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hex-encoded SHA-256 of the downloaded archive/file. Verified before extraction when present."
        },
        "launcher": {
          "type": "string",
          "description": "Path to the executable, relative to Apps/<id>/, e.g. 'FirefoxPortable.exe' or 'Contents/MacOS/firefox'."
        },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
